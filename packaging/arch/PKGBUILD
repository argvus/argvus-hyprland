# Maintainer: William C. Canin
pkgname=argvus-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="Rofi, Wofi and shell integration utilities for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-shell"
license=('GPL-3.0-only')
depends=(
  'argvus-session'
  'argvus-appearance'
  'argvus-terminal'
  'bash'
  'gpu-screen-recorder'
  'hyprland'
  'hyprshot'
  'jq'
  'libnotify'
  'procps-ng'
  'rofi'
  'rofi-calc'
  'rofimoji'
  'satty'
  'wofi'
  'xdg-user-dirs'
)
optdepends=(
  'fuzzel: optional application launcher'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}

# Maintainer: William C. Canin
pkgname=argvus-hyprland
pkgver=0.1.0
pkgrel=1
pkgdesc="Hyprland configuration and shell scripts for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-hyprland"
license=('GPL-3.0-only')
depends=(
  'argvus-session'
  'argvus-appearance'
  'argvus-launcher'
  'argvus-terminal'
  'bash'
  'gpu-screen-recorder'
  'hyprland'
  'hyprshot'
  'jq'
  'libnotify'
  'libpulse'
  'procps-ng'
  'satty'
  'systemd'
  'xdg-user-dirs'
)
provides=('argvus-shell')
conflicts=('argvus-shell')
replaces=('argvus-shell')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}

# Maintainer: William C. Canin
pkgname=argvus-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="Quickshell control panel and shell UI for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-shell"
license=('GPL-3.0-only')
depends=(
  'argvus-session'
  'argvus-accounts'
  'argvus-app-profiles'
  'argvus-appearance'
  'argvus-display'
  'argvus-network'
  'argvus-notifications'
  'argvus-power'
  'argvus-control-center'
  'argvus-terminal'
  'bash'
  'curl'
  'fastfetch'
  'gpu-screen-recorder'
  'hyprland'
  'hyprshot'
  'jq'
  'libnotify'
  'libqalculate'
  'networkmanager'
  'otf-font-awesome'
  'power-profiles-daemon'
  'procps-ng'
  'qt6-declarative'
  'quickshell'
  'rofi'
  'rofi-calc'
  'rofimoji'
  'satty'
  'wireplumber'
  'wofi'
  'xdg-user-dirs'
)
optdepends=(
  'argvus: dispatcher used by the control panel cards in a full desktop install'
  'argvus-widget-telemetry: optional widget telemetry panel controlled by the appearance card'
  'argvus-taskbar: Waybar top panel aligned with the control panel'
  'kdialog: avatar image picker from the user card'
  'nvidia-utils: NVIDIA GPU readout in the system card'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}

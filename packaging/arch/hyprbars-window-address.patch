+// Capture the clicked window before spawning a process. Focus may change before
+// an external command connects to IPC; commands must not target the new focus.
+static std::string argvusWindowAction(std::string command, PHLWINDOW window) {
+    if (!window)
+        return "";
+    const std::string token = "@ARGVUS_WINDOW@";
+    const auto address = std::format("0x{:x}", reinterpret_cast<uintptr_t>(window.get()));
+    size_t position = 0;
+    while ((position = command.find(token, position)) != std::string::npos) {
+        command.replace(position, token.size(), address);
+        position += address.size();
+    }
+    return command;
+}
